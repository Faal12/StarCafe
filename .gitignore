# Godot 4+ specific ignores
.godot/
/android/

# C#/.NET build artifacts
bin/
obj/
.vs/

# Raw third-party asset packs (source material, not shipped directly —
# only the derived/used textures in Assets/Ship etc. are tracked)
/Assets/packs/

# Planet images that currently live outside Assets/packs and are not used yet
/128x128/
/64x64/

# Source artwork the game does not load directly (the derived, cropped
# Assets/Portraits/*_fullbody.png files are what ships). Kept on disk only.
/Assets/Portraits/Character*
/Assets/Portraits/Animation/
/Assets/Portraits/Logo.png*

# Raw working files Godot can't import anyway — keep the PNG derivatives only
*.tiff

# Offline neural voices (Piper + models), fetched by Tools/get_voices.py
/voices/

# Exported demo builds
/build/
